# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000 # Set to your public URL when deployed
SKIP_ENV_VALIDATION=false # Set to true to disable env validation

#-----------------------------------------------------------------------------------------------
# NextAuth
#-----------------------------------------------------------------------------------------------
# You can generate a new secret on the command line with:
# openssl rand -base64 32
#-----------------------------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Auth.js aliases AUTH_URL and AUTH_SECRET are also supported.


#-----------------------------------------------------------------------------------------------
# Google Credentials
#-----------------------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#-----------------------------------------------------------------------------------------------
# Github Credentials
#-----------------------------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ACCESS_TOKEN= # Optional, only for the landing-page GitHub star count

#-----------------------------------------------------------------------------------------------
# Discord Credentials
#-----------------------------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=


#-----------------------------------------------------------------------------------------------
# Database
#-----------------------------------------------------------------------------------------------
DATABASE_URL=


#-----------------------------------------------------------------------------------------------
# Upstash Redis (https://console.upstash.com)
#-----------------------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ENABLE_RATE_LIMITING=false
RATE_LIMITING_REQUESTS_PER_SECOND=20

# Optional AI template composer (server only; local composer works without it)
OPENAI_API_KEY=
OPENAI_MODEL= # Legacy OpenAI default: gpt-4.1-mini
# Compatible providers (server only). AI_API_KEY takes precedence over legacy keys.
AI_API_KEY=
ORCAROUTER_API_KEY=
AI_BASE_URL= # OrcaRouter default: https://api.orcarouter.ai/v1
AI_MODEL= # OrcaRouter default: z-ai/glm-5.3-flash-free
AI_PROTOCOL= # responses or chat (automatic if blank)
# Development only: enable AI in the public studio on loopback. Never enabled in production.
AI_ALLOW_LOCAL_STUDIO=false
